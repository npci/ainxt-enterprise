# Secrets and local environment files
.env
.env.local
.env.*.local
.env.internal
# install.sh copies .env to .env.backup.<timestamp> on every run, so a repo that
# has been installed into holds untracked files full of previous secrets. They
# were not ignored, so `git add -A` would have committed them.
.env.backup*
.env.bak
.env.save
# Organisation-specific env files. Never commit these — they hold real
# infrastructure addresses and credentials. Enforced, not left to a checklist:
# the release depended on someone remembering to uncomment one line here.
.env.npci
.env.*.internal
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets/

# HSM configuration — may contain real HSM host addresses and credentials.
# Use hsm-config.yml.example as the template. Never commit the real file.
hsm-config.yml
hsm-config.yaml

