# ABStudio runtime
ABStudio/backend/data/agent_logs.jsonl

# ABStudio runtime output directories — generated at runtime, must never be committed.
# Contains OCR cache, workflow outputs, agent run artefacts, and uploaded documents.
# These directories are created automatically by the platform on first run.
# See: ABStudio/backend/app/core/ocr_cache.py, app/engine/native_engine.py
ABStudio/backend/runtime_artifacts/
ABStudio/backend/tmp/
ABStudio/tmp/

# OSS session working files (temp dependency resolution artifacts)
tmp_dep_*.json
AiNxt_OSS_Readiness_Report_*.docx

# Pre-release audit reports — internal review material, never published.
# These record unfixed findings, internal infrastructure references and
# security observations verbatim, so committing them would defeat the point
# of the audit that produced them. Ignored as a directory, including any
# nested output, so no future report can be added by `git add -A`.
AUDIT_OUTPUT/

# Local AI/editor tool settings (per-developer, never shared)
.claude/
node_modules/