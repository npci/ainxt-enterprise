SDLC_CLI_IMPLEMENT_BASE_TURNS=10
SDLC_CLI_IMPLEMENT_MAX_TURNS=30
SDLC_CLI_IMPLEMENT_TURNS_PER_FILE=5
SDLC_CLI_IMPLEMENT_TURN_MULTIPLIER=1.5
