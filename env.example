ZOHO_CRM_URL=


# =============================================================================
# SECURITY / ENCRYPTION
# =============================================================================

# UI branding — "Internal Use Only" compliance text
# false (OSS default) — login page shows "Secured · All access logged"
# true  (enterprise)        — login page shows "Secured · Internal Use Only · All access logged"
INTERNAL_USE_ONLY=false

# Auto-seed admin user
# AUTO_SEED_ADMIN=true  → OSS default. On first boot, if the users table is
#                         empty, a default admin user is created automatically
#                         and credentials are printed to the console once.
#                         Set to false once your team is set up.
# AUTO_SEED_ADMIN=false → common enterprise default. No auto-seed (LDAP provisions users).
AUTO_SEED_ADMIN=true

# Self-registration (GAP-3)
# ENABLE_SELF_REGISTRATION=true  → OSS default. Shows a "Create account" link on
#                                   the login page. Any visitor can register and
#                                   choose their role (Admin or User).
# ENABLE_SELF_REGISTRATION=false → common enterprise default. Hides the sign-up link entirely.
#                                   All users are provisioned via LDAP/SCIM.
#                                   The POST /auth/register API also returns 403.
ENABLE_SELF_REGISTRATION=true

# Input sanitization / validation kill-switch
# INPUT_SANITIZATION_ENABLED=true  → default. Every field routed through
#                                    core/security_validation.py (login/register,
#                                    chat, SDLC, connectors, broadcast, etc.) is
#                                    actually validated + sanitized (XSS pattern
#                                    checks, identifier allow-lists, URL scheme
#                                    checks) before use.
# INPUT_SANITIZATION_ENABLED=false → every one of those validators becomes a
#                                    no-op pass-through — the raw value is
#                                    returned unchanged and always reports
#                                    "valid". Single global kill-switch, useful
#                                    for fast rollback if a validator turns out
#                                    too strict for a real workload.
# This same flag also gates the client-side mirror validators in
# ai-ui/src/utils/securityValidation.js — the frontend reads it once from
# GET /auth/ui-config (input_sanitization_enabled) and, when false, its own
# checks become no-ops too, matching the backend exactly.
INPUT_SANITIZATION_ENABLED=true

# Forgot password (GAP-6)
# ENABLE_FORGOT_PASSWORD=true  → OSS default. Shows "Forgot password?" link on
#                                 the login page. Generates a temporary password
#                                 and delivers it via SMTP email (if AINXT_SMTP_HOST
#                                 is set) or prints it to the server console log.
#                                 User logs in with temp password, then changes it
#                                 via Profile → Security.
# ENABLE_FORGOT_PASSWORD=false → common enterprise default. Hides the link entirely.
#                                 Users reset passwords via the corporate directory.
ENABLE_FORGOT_PASSWORD=true

# Email for the auto-seeded admin user (and the manual seed script).
# Override to use your own domain.
SEED_ADMIN_EMAIL=admin@ainxt.local

# Password for the auto-seeded admin.
# Leave empty and the platform generates a random 20-char password at first
# boot, printing it ONCE to the console/docker logs — save it then. Set a value
# here before first boot if you want to choose the initial password yourself.
# Either way, change it after first login (Profile → Security).
# Lost a generated password? Use "Forgot password" on the login page.
SEED_ADMIN_PASSWORD=

# Optional secondary user created by scripts/seed.py (manual run only).
# Not auto-created at gateway boot — only the admin is auto-seeded.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# CKMS (Cryptographic Key Management Service)

CKMS_ENABLED=false

# PII_PAYLOAD_ENCRYPTION_ENABLED — encrypt sensitive fields (email, name,
# phone/mobile) in outgoing API response payloads with AES-256-GCM. Does NOT
# change how these fields are stored in the database — payload only. When
# false (OSS default), responses are unchanged (plaintext).
# Requires PII_ENCRYPTION_KEY to be set when true.
PII_PAYLOAD_ENCRYPTION_ENABLED=false

# PII_ENCRYPTION_KEY — URL-safe base64-encoded 32-byte AES-256-GCM key used
# only when PII_PAYLOAD_ENCRYPTION_ENABLED=true. Generate your own — do NOT
# reuse this sample in any real deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Sample: PII_ENCRYPTION_KEY=12345678-waefsdfgeds*****
PII_ENCRYPTION_KEY=

# ── MODEL PROVIDER POSTURE ───────────────────────────────────────────────────
# LLM_PROVIDER — the single switch that decides whether this deployment calls a
# cloud model provider at all. See docs/PROVIDERS.md.
#
#   cloud   (default) Route tiers to the cloud models named in
#                     core/model_registry.py. Requires credentials only for the
#                     providers you actually route to.
#   local             Resolve EVERY tier to LOCAL_LLM_MODEL_NAME, served by your
#                     own OpenAI-compatible endpoint (Ollama / vLLM / LiteLLM).
#                     No cloud account needed; no prompt leaves your network.
#
# An unrecognised value stops the process at import rather than silently routing
# prompts to a provider you did not choose.
#
# Setting this to `local` is the privacy-preserving posture: it eliminates the
# cross-border transfer of prompt content entirely.
LLM_PROVIDER=cloud

# HSM_PROVIDER
HSM_PROVIDER=
HSM_CONFIG_PATH=

AUDIT_SIGNING_KEY=
VAULT_ENCRYPTION_KEY=


