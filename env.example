AINXT_GATEWAY_URL=
AINXT_GOVERNANCE_UI_BASE=


# =============================================================================
# KNOWLEDGE BASE — ADVANCED RETRIEVAL TUNING
# =============================================================================
# Reranker — cross-encoder model for result re-ranking after vector search.
# Leave empty to disable reranking (uses vector similarity only).
RERANKER_MODEL=
RERANKER_VARIANT=
RERANKER_MIN_SCORE=0.30
RERANKER_BATCH_SIZE=32
RERANKER_MAX_CANDIDATES=100
RERANKER_THREADS=2
# Hybrid retrieval (BM25 + vector, fused with RRF)
HYBRID_RRF_ENABLED=false
# Graph-based retrieval
GRAPH_RETRIEVAL_ENABLED=false
GRAPH_SUB_EXPIRY_MIN=60
GRAPH_SUB_NOTIFICATION_URL=
# KB search defaults
KB_SEARCH_DEFAULT_TOP_K=10
KB_SEARCH_PROVIDER=
KB_SEARCH_NAMESPACES=
KB_SEARCH_ACL_BAND=
KB_SKIP_PREFLUSH_GROUNDING=false
# KB disambiguation
KB_DISAMBIG_MIN_DOCS=4
# KB entity extraction
KB_ENTITY_LLM_ENABLED=false
# KB document cache
KB_DOC_CACHE_TTL_SECONDS=300
# KB coverage map (deep-dive retrieval for long documents)
KB_COVERAGE_ENABLED=false
KB_COVERAGE_DOC_FITS_TOKENS=8000
KB_COVERAGE_MAP_MODE=section
KB_COVERAGE_MAP_SECTION_CHARS=2000
KB_COVERAGE_MAX_SECTIONS=20
KB_COVERAGE_MAP_CONCURRENCY=4
KB_COVERAGE_MAP_LOCAL_THRESHOLD=0.5
KB_COVERAGE_GLOBAL_CONCURRENCY=2
KB_COVERAGE_GLOBAL_TIMEOUT_S=60
KB_COVERAGE_GLOBAL_TTL_MS=300000
# KB sufficiency gate
KB_GATE_SUFFICIENCY_THRESHOLD=0.6
KB_GATE_MIN_SECTION_COVERAGE=0.3
KB_GATE_RERANK_MIN_TOP=3
KB_GATE_RERANK_FLAT_GAP=0.05
# KB replica (read replica for high-availability)
KB_REPLICA_ENABLED=false
KB_REPLICA_PEER_URL=
KB_REPLICA_STRICT=false
KB_REPLICA_TIMEOUT_SECONDS=5
# NeMo embedding backend
NEMO_EMBEDDING_INDEX_BACKEND=


# =============================================================================
# SEMANTIC CACHE & MEMORY
# =============================================================================
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_RESULTS=5
SEMANTIC_CACHE_MAX_DAYS=30
SEMANTIC_DEDUP_THRESHOLD=0.95
SEMANTIC_CONFIDENCE_MAX=0.99
SEMANTIC_MEMORY_ENABLED=false
SEMANTIC_MEMORY_THRESHOLD=0.85
SEMANTIC_MEMORY_MIN_CONFIDENCE=0.7
SEMANTIC_MEMORY_MAX_RESULTS=10
SEMANTIC_MEMORY_MAX_DAYS=90
MEMORY_INJECT_MAX_TOKENS=500
PROMPT_CACHE_TTL_SEC=300


# =============================================================================
# EMBED SERVICE (multi-URL load balancing)
# =============================================================================
# EMBED_SVC_URLS — comma-separated list of embed service URLs for load balancing.
# Leave empty to use EMBED_SVC_URL (single instance).
EMBED_SVC_URLS=


# =============================================================================
# DOCUMENT GENERATION — ADVANCED
# =============================================================================
# PDF parsing
PDF_HYBRID_ENABLED=false
PDF_HYBRID_MAX_PAGES=50
PDF_MIN_NATIVE_CHARS=100
PDF_SMART_PARALLEL_ENABLED=false
# Document streaming
DOC_STREAM_MAX_SEC=300
DOC_STREAM_POLL_SEC=2
# Document intent
DOC_INTENT_TRUST_THRESHOLD=0.7
# Document generation refinement
DOCGEN_REFINE=false
DOCGEN_BENCH_JUDGE=
# PPT image generation timeout
PPT_IMAGE_TIMEOUT_SEC=30
# Vision QA extra controls
DOC_VISION_QA_BUDGET_S=60
DOC_VISION_QA_MAX_REVISIONS=2
# Docling OCR artifacts path
DOCLING_ARTIFACTS_PATH=
PADDLEOCR_MODELS_PATH=
# PaddleOCR / Docling parse timeout
PARSE_TIMEOUT=300
PARSE_SVC_ENABLED=false
# Generated files TTL
GENERATED_FILES_TTL_SECONDS=86400
IMAGE_RETAIN_DAYS=30
# Presenton data directory (presentation tool)
PRESENTON_DATA_DIR=


# =============================================================================
# SDLC PIPELINE — ADVANCED TUNING
# =============================================================================
