# =============================================================================
# DPI — Digital Public Infrastructure (India Stack)
# =============================================================================
# DPI connectors: Account Aggregator (financial data), DigiLocker (documents),
# UPI, BBPS. Production access requires RBI/UIDAI licensing — only licensed
# financial institutions can use production DPI endpoints.
#
# DPI_SANDBOX=true  (OSS default) — runs fully offline against synthetic
#                   fixtures. No licensing required. Safe for development,
#                   testing, and OSS deployments.
# DPI_SANDBOX=false (common enterprise default) — uses real production DPI endpoints.
#                   Requires RBI/UIDAI licensing. Do NOT set false unless
#                   your organisation has the required regulatory approvals.
DPI_SANDBOX=true

# DPI_SANDBOX_SIGNING_KEY — key used to sign synthetic consent artifacts in
# sandbox mode. Change this in production sandbox environments.
