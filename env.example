# =============================================================================
# COMPLIANCE / SECURITY SCANS
# =============================================================================
# COMPLIANCE_SERVICE_ENABLED - toggle for the compliance service
# (agents/compliance_engine.py). Scans every prompt and response for PCI/PII.
# false (default): disabled, nothing is scanned or redacted.
# true:            full scanning and redaction active.
COMPLIANCE_SERVICE_ENABLED=false

# PRIVACY_SERVICE_ENABLED - toggle for the privacy service
# (services/privacy_svc, port 8004). ML-based PII detection via ONNX model.
# Requires a ~1GB model download. Only meaningful when COMPLIANCE_SERVICE_ENABLED=true.
# false (default): ML layer skipped; regex detectors still run if compliance is on.
# true:            ML model called for context-aware PII detection.
PRIVACY_SERVICE_ENABLED=false

COMPLIANCE_CONFIG=
COMPLIANCE_ML_CACHE=true
COMPLIANCE_ML_CACHE_SIZE=1000
COMPLIANCE_SCAN_HISTORY=true
COMPLIANCE_SCAN_LLM_OUTPUT=true
