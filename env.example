# =============================================================================
# AiNxt ENterprise - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Notes:
#   - Lines prefixed with # are comments (ignored).
#   - Leave placeholder values as-is if not applicable to your setup.
#   - Never commit your .env file to version control.
# =============================================================================


# #############################################################################
# START HERE — the only five things you must set
# #############################################################################
#
# This file is long because the platform is configurable, not because setup is.
# Everything below this block has a working default or is optional. Set these
# five and the platform starts; come back for the rest when you need it.
#
# Or skip the reading entirely:  ./scripts/setup.sh
# which generates the secrets, starts Postgres and Redis, runs the migrations
# and checks the result.
#
#   1. JWT_SECRET          signs session tokens. Any long random string.
#                          Generate:  openssl rand -hex 32
#
#   2. POSTGRES_HOST       `localhost` if you use the bundled docker-compose.
#   3. POSTGRES_PASSWORD   whatever you set for Postgres. With docker-compose
#                          this is the value compose reads from this same file,
#                          so pick one and it is used in both places.
#
#   4. REDIS_HOST          `localhost` if you use the bundled docker-compose.
#
#   5. ONE model provider. Any single one of these is enough:
#                          LOCAL_LLM_BASE_URL=http://localhost:11434/v1   (Ollama)
#                          OPENAI_API_KEY=sk-...
#                          ANTHROPIC_API_KEY=sk-ant-...
#                          GEMINI_API_KEY=...
#                          LITELLM_BASE_URL=http://localhost:4000
#
# Nothing here bundles a model. The platform is a gateway; it needs something
# to talk to.
#
# ── How you know it worked ───────────────────────────────────────────────────
# On boot the platform prints a config summary — a ✅/⚠️/❌ line per subsystem
# (Postgres, Redis, LLM, and more). Read that block before debugging anything
# else; it is generated by `startup_config_check()` in core/config.py and it
# tells you which of the five above is missing.
#
# Backend then answers on   http://localhost:9001
# API docs at              http://localhost:9001/ainxt/v1/api/docs
# The frontend (ai-ui) is separate and runs on http://localhost:5173
#
# The first boot creates an admin user and prints a generated password ONCE.
# Copy it before you clear the terminal, or set SEED_ADMIN_PASSWORD below first.
# #############################################################################


# =============================================================================
# APPLICATION OWNER (drives all platform-owned resource names)
# =============================================================================
# Single identifier used as the prefix for DB names, schema, Kafka topics,
# file paths, and container prefixes. Set this once — everything else follows.
#
#   APP_OWNER=ainxt  (default) → ainxt_memory, ainxt schema, ainxt.* topics
#   APP_OWNER=<your-org>       → <your-org>_memory,  <your-org> schema,  <your-org>.* topics
#   APP_OWNER=acme             → acme_memory,  acme schema,  acme.* topics
#
# Every individual env var (POSTGRES_DB, PGVECTOR_DB, etc.) always overrides
# APP_OWNER when set explicitly — APP_OWNER is only the default-generator.
#
# ── What APP_OWNER drives automatically ──────────────────────────────────────
#   POSTGRES_DB            → {APP_OWNER}_memory
#   POSTGRES_SCHEMA        → {APP_OWNER}
#   PGVECTOR_DB            → {APP_OWNER}_vectors
#   DEPENDENCY_RESOLVER_DB → {APP_OWNER}_dependency_resolver
#   SANDBOX_PREFIX         → {APP_OWNER}_sandbox_
#   BUILD_DEPS_COLUMN      → {APP_OWNER}_deps
#   KAFKA_TOPIC_PREFIX     → {APP_OWNER}   (topics: {APP_OWNER}.chat_history etc.)
#   COACH_EVENT_TOPIC      → {APP_OWNER}.coach_event
#   LDAP_BASE_DN           → DC={APP_OWNER},DC=org,DC=in
#   PRESENTON_USER         → {APP_OWNER}
#   File paths (prod)      → /var/lib/{APP_OWNER}/docs, /opt/{APP_OWNER}/workspaces etc.
#
# ── Existing deployments ─────────────────────────────────────────
# If you already have POSTGRES_DB, PGVECTOR_DB, LDAP_BASE_DN etc. explicitly
# set in your .env, those values take priority — APP_OWNER only fills the gaps.
#
# Minimum additions for an existing existing enterprise deployment:
#   APP_OWNER=<your-org>
#   CORS_ALLOWED_ORIGINS=https://<your-frontend-domain>   (or * for wildcard)
#   SSL_VERIFY=false   (if your internal services use self-signed certificates)
#
APP_OWNER=ainxt

# Human-readable organisation name shown in the login page footer and UI.
# OSS default: AiNxt
# Example: PLATFORM_NAME=Your Organisation Name
PLATFORM_NAME=AiNxt

# =============================================================================
# SECURITY SETTINGS (always set explicitly — NOT driven by APP_OWNER)
# =============================================================================
# CORS — which origins are allowed to call the embed/privacy/translate services.
# Default is empty (same-origin only — secure for OSS).
# Internal/enterprise deployments: set to your frontend domain(s) or * for wildcard.
#
# Examples:
#   CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://studio.yourdomain.com
#   CORS_ALLOWED_ORIGINS=*   # wildcard — use only on trusted internal networks
#
CORS_ALLOWED_ORIGINS=

# SSL/TLS certificate verification for outbound HTTPS calls
# (LLM proxy → Atlassian, guardrails → NeMo embeddings, ABStudio generation).
# Default: true (verify certificates — correct for public CAs).
# Set false only if your internal services use self-signed or private CA certs.
# Better alternative: point SSL_CA_BUNDLE at your internal CA bundle instead.
#
SSL_VERIFY=true
# Custom CA bundle — set if your internal services use a private/self-signed CA
SSL_CA_BUNDLE=


# =============================================================================
# CORE APPLICATION
# =============================================================================
# JWT secret for token signing (generate a strong random string — required)
JWT_SECRET=
# Fallback alias for JWT_SECRET — set either one (JWT_SECRET takes priority)
SECRET_KEY=

# Fernet key — AES-256 encryption for OAuth connector tokens stored in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, connector tokens (GitLab, GitHub, M365) are stored unencrypted.
FERNET_KEY=

# ANSWER_ASSERTION_SECRET — shared secret for the answer assertion service.
# Used to verify signed assertion requests. Leave empty to disable assertion signing.
ANSWER_ASSERTION_SECRET=

# AiNxt_NEXUS_URL — internal Nexus/Artifactory URL for package resolution.
# Only needed in air-gapped enterprise deployments. Leave empty for public registries.
AiNxt_NEXUS_URL=

# Main application credentials
AINXT_TOKEN=
AINXT_PASS=
AINXT_USER_TOKEN=
AINXT_ADMIN_TOKEN=

# Application email (for notifications)
AINXT_EMAIL=

# Application URL (base URL, no trailing slash)
AINXT_URL=


# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Main application DB — connection details
# All POSTGRES_* vars are required. POSTGRES_PASSWORD has no default — must be set.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Schema name — defaults to APP_OWNER value (ainxt). Override for custom schema.
POSTGRES_SCHEMA=
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/<DB_NAME>
# Default open-source DB names. Override with legacy names in production if needed.
POSTGRES_DB=ainxt_memory
PGVECTOR_DB=ainxt_vectors
# pgVector password — falls back to POSTGRES_PASSWORD if not set
PGVECTOR_PASSWORD=
DEPENDENCY_RESOLVER_DB=ainxt_dependency_resolver
SANDBOX_PREFIX=ainxt_sandbox_

# Read replicas — optional. Leave empty to use the primary for all reads.
# Set these if you have a Postgres read replica for query offloading.
POSTGRES_READ_HOST=
POSTGRES_READ_PORT=
POSTGRES_READ_USER=
POSTGRES_READ_PASSWORD=
POSTGRES_READ_DB=
# pgVector read replica
PGVECTOR_READ_HOST=
PGVECTOR_READ_PORT=
PGVECTOR_READ_USER=
PGVECTOR_READ_PASSWORD=
BUILD_DEPS_COLUMN=ainxt_deps
PPT_TEMPLATE_PATH=assets/ainxt_template.pptx
# PPT_IMAGE_PROVIDER — LLM provider used to generate slide images.
# Options: gemini_flash (default), openai, local
PPT_IMAGE_PROVIDER=
# PPT_LLM_MODEL — model used for slide content generation.
PPT_LLM_MODEL=

# AgentChain specific DB
AGENTCHAIN_POSTGRES_HOST=localhost
AGENTCHAIN_POSTGRES_PORT=5432
AGENTCHAIN_POSTGRES_DB=<DB_NAME>
AGENTCHAIN_POSTGRES_USER=<USER>
AGENTCHAIN_POSTGRES_PASSWORD=<PASSWORD>

# pgVector (dedicated vector DB — can be same host as Postgres)
# Falls back to POSTGRES_* values if not set — safe for single-server installs.
PGVECTOR_HOST=
PGVECTOR_PORT=
PGVECTOR_USER=

# Vector DB (Chroma)
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_HTTP_PORT=8000
CHROMA_DATABASE=
CHROMA_TENANT=

# Vector DB (PostgreSQL for embeddings)
VECTOR_POSTGRES_HOST=localhost
VECTOR_POSTGRES_PORT=5432

# Chroma embeddings URL (if using external embedding service)
CHROMA_EMBED_URL=


# =============================================================================
# REDIS
# =============================================================================
# Redis is required — used for sessions, budget enforcement, job queues, and
# token streams. Standard Redis install works out of the box.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_CLIENT_CONFIG — which KV backend hosts the logical databases.
# REDIS is the only supported value and the default; the variable exists so a
# logical DB can be repointed by configuration (see REDIS_CLIENT_CONFIG_DB{n}).
REDIS_CLIENT_CONFIG=REDIS


# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# AINXT_SMTP_HOST — leave empty to disable all email features (OSS default).
# When empty, send_html_email() returns False immediately — no connection
# attempt, no timeout. Email features (monthly statements, HOD digest,
# broadcast, notifications) are silently skipped.
#
# Set to your SMTP server to enable email:
#   Gmail:     smtp.gmail.com        (port , TLS)
#   Outlook:   smtp.office365.com    (port , TLS)
#   SendGrid:  smtp.sendgrid.net     (port , TLS)
#   Mailgun:   smtp.mailgun.org      (port , TLS)
#   Local:     localhost             (port ,  no auth)
AINXT_SMTP_HOST=
AINXT_SMTP_PORT=
AINXT_SMTP_FROM=
AINXT_SMTP_TIMEOUT=
# SMTP credentials — set if your relay requires authentication (most cloud SMTP does).
# Leave empty for unauthenticated internal relays.
AINXT_SMTP_USER=
AINXT_SMTP_PASSWORD=


# =============================================================================
# LDAP / AUTHENTICATION
# =============================================================================
# LDAP_ENABLED=false (OSS default) — local bcrypt password login.
# LDAP_ENABLED=true  — validate passwords against Active Directory / LDAP.
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
# LDAP_BIND_DN / LDAP_BIND_PASSWORD — service account credentials for LDAP search.
# Required when your LDAP server does not allow anonymous binds (most enterprise AD).
# Example: LDAP_BIND_DN=CN=svc-ainxt,OU=ServiceAccounts,DC=corp,DC=example,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# LDAP_USE_SSL — connect to LDAP over SSL (ldaps://). Default: false.
# LDAP_USE_STARTTLS — upgrade plain connection to TLS via STARTTLS. Default: true.
LDAP_USE_SSL=false
LDAP_USE_STARTTLS=true
# LDAP_USER_FILTER — LDAP search filter to find user objects.
# Default: (&(objectClass=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_USER_FILTER=
# LDAP_USER_SEARCH_FILTER — filter to look up a specific user by email.
# Default: (mail={email})
LDAP_USER_SEARCH_FILTER=
# LDAP_SYNC_HOUR — hour of day (0-23) to run the nightly AD sync. Default: 2 (2 AM).
LDAP_SYNC_HOUR=2

# =============================================================================
# SSO — Keycloak / Azure AD
# =============================================================================
# SSO_PROVIDER — set to "keycloak" or "azure_ad" to enable SSO login.
# Leave empty to use local password login only (OSS default).
SSO_PROVIDER=
# Generic SSO credentials (used by some SSO providers)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORITY=
SSO_POST_LOGIN_REDIRECT=/ui

# Keycloak SSO (set SSO_PROVIDER=keycloak to activate)
# KEYCLOAK_CLIENT_ID: the client name registered in your Keycloak realm.
# OSS default: "ainxt" — create a client named "ainxt" in your Keycloak realm.
# Legacy:      "<legacy-prefix>" — an existing Keycloak client registration.
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=ainxt
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REALM=

# Azure AD SSO (set SSO_PROVIDER=azure_ad to activate)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# LDAP_AUTO_PROVISION — controls what happens when a valid LDAP user logs in
# but has no existing record in the local users table.
#
# true  (OSS default) — auto-provision the user on first successful LDAP login.
#                       No pre-registration required. Any valid AD user can log in.
# false (common enterprise default) — controlled rollout gate. User must be pre-registered
#                        in the DB before they can log in. Returns 403 if not found.
LDAP_AUTO_PROVISION=true

# DEFAULT_AD_LEVEL — the ad_level assigned to every new self-registered user.
# ad_level scale: 0=most senior exec, 6=most junior engineer.
# Does NOT affect LDAP users — their level comes from Active Directory.
#
# 3 (OSS default)  — mid-level. With APPROVAL_AD_LEVEL=6 (OSS default), level 3
#                    users can approve everything. Good starting point for a small team.
# 6 (common enterprise default) — most junior. AD sync sets the real level after first login.
DEFAULT_AD_LEVEL=3

# APPROVAL_AD_LEVEL — the maximum ad_level that can approve budget requests,
# products, and governance actions. ad_level scale: 0=most senior, 6=most junior.
# "can approve" = ad_level <= APPROVAL_AD_LEVEL OR role == "admin".
#
# 6 (OSS default)  — everyone can approve. No org hierarchy needed for a small team.
# 3 (common enterprise default) — only senior managers (L3 and above) can approve.
APPROVAL_AD_LEVEL=6


# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins for cross-origin browser requests.
# - PRODUCTION: set this to your real frontend domains (never "*").
#   Example: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://studio.yourdomain.com
# - LOCAL DEV: uncomment the line below to allow ai-ui on localhost:3000/5173.
# - Leave empty or unset to allow same-origin requests only (most secure default).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# LLM PROVIDERS
# =============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Google Gemini (vision, multimodal, coding)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama (local LLM — embed model only via embed svc)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_LLM_MODEL=llama3.2

# Local LLM / LiteLLM proxy (Ollama, vLLM, LiteLLM, or any OpenAI-compatible endpoint)
# Set this to your local LLM server. Leave empty to use only cloud providers.
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=
# Backward-compat alias — same as LOCAL_LLM_BASE_URL
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Forward proxy — for outbound cloud API calls (OpenAI, Anthropic, Google)
# Leave empty if your server has direct internet access.
FORWARD_PROXY_URL=
# System-level proxy (used by some libraries that read HTTPS_PROXY directly)
HTTPS_PROXY=

# LLM Proxy — internal proxy server that routes LLM calls and holds API keys
# Leave empty for direct cloud API access (Ollama, OpenAI, Anthropic)
LLM_PROXY_URL=

# GENERAL_CHAT_MODEL — override the default chat model for all conversations.
# Leave empty to use the platform's auto-selected model based on tier routing.
# Example: GENERAL_CHAT_MODEL=gpt-4o  or  GENERAL_CHAT_MODEL=ollama/llama3.2
GENERAL_CHAT_MODEL=

# OpenAI-compatible endpoint (ABStudio — separate from LOCAL_LLM_BASE_URL)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# LLM Proxy
LLM_PROXY_TOKEN=

# PROXY_KEY_FETCH_URL — URL from which the LLM Proxy fetches API keys at startup
# (internal CKMS key delivery endpoint). Leave empty to use keys from .env directly.
# Enterprise: set to the internal CKMS router URL (e.g. http://<ckms-host>/internal/ckms/keys).
# OSS default: empty — keys are read from environment variables as normal.
PROXY_KEY_FETCH_URL=

# PROXY_KEY_FETCH_TIMEOUT_SEC — timeout in seconds for the key fetch request.
# Default: 5. Increase if the CKMS endpoint is slow to respond at startup.
PROXY_KEY_FETCH_TIMEOUT_SEC=5

# PROXY_KEY_TOKEN — optional shared secret for /internal/ckms/proxy-keys.
# When set, the endpoint requires the same value in the X-Proxy-Key-Token
# header and returns 403 otherwise; set the identical value on both the
# platform host and the LLM Proxy host. Leave empty to keep the previous
# behaviour, where network/nginx rules are the only access control.
PROXY_KEY_TOKEN=

# Sync secret key for distributed communication
SYNC_SECRET_KEY=


# =============================================================================
# SERVICE ENDPOINTS
# =============================================================================
# Embed Service — used by semantic cache, semantic memory, and KB retrieval.
# Must include the port. Default port is 8001.
# This value is read by both core/config.py and store/semantic_cache.py —
# both now default to http://localhost:8001 when the env var is not set.
EMBED_SVC_URL=http://localhost:8001
EMBED_SVC_PORT=8001

# Privacy Service
PRIVACY_SVC_URL=http://localhost
PRIVACY_SVC_PORT=8002

# Translate Service
TRANSLATE_SVC_URL=http://localhost
TRANSLATE_SVC_PORT=8003

# Compress Service
COMPRESS_SVC_URL=

# =============================================================================
# FILE STORAGE PATHS
# =============================================================================
# KB_DOC_STORAGE_PATH — where approved knowledge base documents are stored on disk.
# OSS default (auto-derived when not set):
#   local mode → {tempdir}/ainxt_kb_docs   (e.g. /tmp/ainxt_kb_docs)
#   prod  mode → /var/lib/ainxt/kb_docs
# Override to use a custom path (e.g. a mounted volume in Docker/k8s).
# The directory is created automatically on first use if it does not exist.
KB_DOC_STORAGE_PATH=

# KB_RETRIEVAL_SCOPE — controls which knowledge sources are searched during RAG.
# "both" (default) — search both the platform KB and user-uploaded documents.
# "kb_only"        — search only the platform knowledge base.
# "docs_only"      — search only user-uploaded documents.
KB_RETRIEVAL_SCOPE=both

# KB_FOLLOWUP_CONDENSE_ENABLED — condense follow-up questions in KB chat for
# better retrieval accuracy. When true, a lightweight LLM call rewrites the
# follow-up as a standalone question before vector search.
# true (default) — enabled. Improves multi-turn KB accuracy at minor cost.
# false          — disabled. Saves one LLM call per follow-up turn.
KB_FOLLOWUP_CONDENSE_ENABLED=true

# KB_CONTEXT_CHAR_CAP — character cap applied to KB context injected into the
# LLM prompt. Default: 400000 (~400k chars). Reduce for smaller context windows.
KB_CONTEXT_CHAR_CAP=400000

# ASK_ATTACH_CHAR_CAP — character cap applied to attachment text in KB ask.
# 0 (default) — no cap; full attachment text is included.
# Set to e.g. 8000 to limit very large attachments and reduce token cost.
ASK_ATTACH_CHAR_CAP=0

# LOCAL_KV_CACHE_HOIST — enable KV-cache hoisting for local LLM models in KB ask.
# true (default) — system prompt is hoisted to a cached prefix for local models.
# false          — disable if your local model does not support prefix caching.
LOCAL_KV_CACHE_HOIST=true


# =============================================================================
# CODEWIKI — AI-powered codebase documentation generator
# =============================================================================
# CodeWiki generates structured Markdown documentation for any codebase by
# analysing the source tree with an LLM. It runs as a background worker job.
#
# CODEWIKI_DOCS_DIR — directory where generated documentation pages are stored.
# Required for production. Leave empty to use a temp directory (dev only).
# Example: CODEWIKI_DOCS_DIR=/var/lib/ainxt/codewiki_docs
CODEWIKI_DOCS_DIR=

# CODEWIKI_BASE_URL — LLM base URL for CodeWiki generation.
# Leave empty to fall back to the platform gateway (NEURON_BASE_URL / gateway).
CODEWIKI_BASE_URL=

# CODEWIKI_API_KEY — API key for the CodeWiki LLM endpoint.
# Leave empty to fall back to the platform API key (NEURON_API_KEY).
CODEWIKI_API_KEY=

# CODEWIKI_MAIN_MODEL — primary model used for page generation.
# Leave empty to use the platform default model.
CODEWIKI_MAIN_MODEL=

# CODEWIKI_CLUSTER_MODEL — model used for module clustering / grouping.
# Leave empty to use CODEWIKI_MAIN_MODEL.
CODEWIKI_CLUSTER_MODEL=

# CODEWIKI_FALLBACK_MODEL — fallback model if the main model fails.
# Leave empty to disable fallback.
CODEWIKI_FALLBACK_MODEL=

# CODEWIKI_PROVIDER — LLM provider override (e.g. openai, anthropic, ollama).
# Leave empty to auto-detect from the base URL.
CODEWIKI_PROVIDER=

# CODEWIKI_MAX_LOG_CHARS — maximum characters to retain in the worker job log.
# Default: 2000000 (~2 MB). Reduce for low-memory deployments.
CODEWIKI_MAX_LOG_CHARS=2000000


# PARSE_SVC_URL — URL of the document parsing microservice (Docling/OCR).
# Leave empty to use the built-in parser (slower but no extra service needed).
# Example: PARSE_SVC_URL=http://localhost:8002
PARSE_SVC_URL=
# PARSE_SVC_TIMEOUT — timeout in seconds for parse service requests. Default: 1800.
PARSE_SVC_TIMEOUT=1800

# File storage paths — leave empty to auto-derive from DEPLOYMENT_MODE + APP_OWNER.
# local dev: {tempdir}/{APP_OWNER}_* | prod: /var/lib/{APP_OWNER}/*
# Override to point at a persistent volume in Docker/k8s/bare-metal prod.
AINXT_DOC_STORAGE_DIR=
AINXT_IMAGE_STORAGE_DIR=
AINXT_DOC_DIR=
MEDIA_DIR=
BROADCAST_ATTACHMENT_DIR=
PRIVACY_AUDIT_LOG=
REPO_CLONE_ROOT=

# Builder / SDLC workspace paths
BUILDER_WORKSPACE_ROOT=
BUILDER_CACHE_ROOT=
BUILD_LOG_DIR=
# Builder Docker images — used by the SDLC sandbox to build code.
# Leave empty to use the default image names (ainxt-builder-*:latest).
# Override if you build and push your own images to a private registry.
BUILDER_REGISTRY=
BUILDER_IMAGE_PYTHON=ainxt-builder-python-311:latest
BUILDER_IMAGE_NODE=ainxt-builder-node-20:latest
BUILDER_IMAGE_JVM=ainxt-builder-jvm-21:latest
BUILDER_IMAGE_SYSTEMS=ainxt-builder-systems:latest
# Build timeouts and retries
BUILD_TIMEOUT_SECS=300
BUILD_COLD_TIMEOUT_SECS=1800
BUILD_MAX_RETRIES=1
# Container-internal paths for builder (only change if using custom Docker images)
PIP_CACHE_CONTAINER_PATH=/cache/pip
POETRY_CACHE_CONTAINER_PATH=/cache/pypoetry
PYTHON_VENV_CONTAINER_PATH=/venv
PYTHON_USE_PERSISTENT_VENV=true
# Multi-repo SDLC install limits
MULTI_REPO_INSTALL_TIMEOUT=3600
MULTI_REPO_INSTALL_MEMORY=2g

# ABStudio / CLI paths
AINXT_PLATFORM_ROOT=
AINXT_CLI_BIN=
GENERATED_FILES_DIR=
SDLC_CLI_BINARY_PATH=
SDLC_CLI_LOG_DIR=

# Sandbox — package registry overrides (for air-gapped / enterprise deployments)
# Leave empty to use public registries (PyPI, npm, Maven Central etc.)
SANDBOX_DOCKER_REGISTRY=
SANDBOX_MAVEN_REPO_URL=
SANDBOX_NPM_REGISTRY_URL=
SANDBOX_GO_PROXY=
SANDBOX_PIP_INDEX_URL=
SANDBOX_GEM_SOURCE_URL=
SANDBOX_NUGET_SOURCE_URL=
SANDBOX_CARGO_REGISTRY_URL=
SANDBOX_COMPOSER_REPO_URL=

# Whisper (Speech-to-Text) Service
WHISPER_SVC_URL=

# Discussions Engine
DISCUSSIONS_ENGINE_BASE_URL=
# DISCUSSIONS_ENGINE_DATA_PATH — where the discussions engine stores its data.
# Auto-derived from APP_OWNER if not set: /var/lib/{APP_OWNER}/discussions-engine
DISCUSSIONS_ENGINE_DATA_PATH=


# =============================================================================
# AGENT CHAIN / WORKFLOW ENGINE
# =============================================================================
# Cowork settings
COWORK_MODEL_LOCKED=
COWORK_FORCED_MODEL=
COWORK_OTEL_ENABLED=false
COWORK_SCHED_BATCH=50
COWORK_SCHED_POLL_SECONDS=5
COWORK_TOOL_POOL=
COWORK_CONNECTOR_RATE_WINDOW=60
COWORK_CONNECTOR_RATE_MAX=5

# Factory settings
FACTORY_BASE_URL=
FACTORY_API_KEY=
FACTORY_MODEL=
FACTORY_LLM_FORCE_STREAM=true
FACTORY_LLM_TIMING=
FACTORY_MATCH_PREFILTER_TOP_N=10
FACTORY_EXISTING_MATCH_MIN_CONFIDENCE=0.8
