# Checkmarx (SAST)
CHECKMARX_HOST_URL=
CHECKMARX_CLIENT_ID=
CHECKMARX_CLIENT_SECRET=

# Semgrep (SAST — used by the AI security scan feature)
# SEMGREP_PATH defaults to "semgrep" — relies on system PATH.
# Install: pip install semgrep  OR  brew install semgrep  OR  apt install semgrep
# Leave empty/unset to use the PATH default. Only set if semgrep is installed
# in a non-standard location (e.g. inside a specific virtualenv).
SEMGREP_PATH=

# Circuit breaker
CIRCUIT_BREAKER_DISABLED=false

# Hard-block engine — blocks requests that exceed a toxicity/risk threshold.
# HARDBLOCK_ENABLED=false (OSS default) — disabled. Set to true to enable.
# HARDBLOCK_THRESHOLD — score above which a request is hard-blocked (0.0–1.0).
HARDBLOCK_ENABLED=false
HARDBLOCK_THRESHOLD=0.75


