AINXT_DOC_PREVIEW_PAGES=3
AINXT_DOC_PREVIEW_SOFFICE_TIMEOUT_S=60
AINXT_DOC_SANDBOX_IMAGE=

# DOC_FOOTER_TEXT — text shown in the footer of every generated document
# (docx, pdf, pptx). Appears as the confidentiality/classification marking.
# OSS default: "Confidential" (generic, no org-specific marking).
# Enterprise example: "Your Org — Confidential" or "Acme Corp — Internal Only".
DOC_FOOTER_TEXT=Confidential

# DOC_BRAND_FILE — relative path (inside skills/ainxt_doc_craft/) to the brand
# contract file injected into document generation prompts.
# Default: brand/BRAND.md (generic AiNxt brand — no org-specific colours or fonts).
# Internal/enterprise: set to brand/INTERNAL_BRAND.md for the built-in internal brand.
# Custom: create brand/<YourOrg>_BRAND.md and set DOC_BRAND_FILE accordingly.
DOC_BRAND_FILE=brand/BRAND.md

# OPENAI_BASE_URL — the OpenAI-compatible API root used for AUDIO (text-to-speech
# and transcription) and EMBEDDINGS.
#
# Default: https://api.openai.com/v1 — identical to the previously hardcoded
# behaviour, so leaving this unset changes nothing.
#
# Why it exists: these three call sites were hardcoded to OpenAI. A deployment
# running local models (LLM_PROVIDER=local) has no OpenAI account, so every TTS
# and transcription request returned 401 and the only workaround was editing
# source. Point this at anything that speaks the same API — LiteLLM, vLLM,
# faster-whisper, openedai-speech, or your own gateway:
#
#   OPENAI_BASE_URL=http://localhost:4000/v1
#
# NOT covered by this setting: OpenAI's organisation cost/usage API
# (services/llm_proxy/main.py `_OPENAI_ADMIN_BASE`). That endpoint only exists at
# OpenAI, so it stays hardcoded; it is only used by the spend reporting feature.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Model configurability added during the OSS audit ────────────────────────
# Each of these replaced a hardcoded literal. Defaults are unchanged, so leaving
# them unset preserves the previous behaviour exactly.
#
# OPENAI_IMAGE_MODEL / OPENAI_IMAGE_FALLBACK — image generation.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_FALLBACK=
#
# MODELS_WITHOUT_TEMPERATURE — comma-separated model-id PREFIXES that reject the
# `temperature` parameter. Was `model.startswith("claude-opus-4")`, i.e. one
# vendor's naming convention; an adopter whose model also rejects temperature had
# no way to say so and every request to it failed.
MODELS_WITHOUT_TEMPERATURE=
#
# DOWNGRADE_MODEL — the model used when a request is downgraded for lack of
# retrieved context. Was pinned to one specific locally-served model.
DOWNGRADE_MODEL=
#
# LOCAL_MODEL_IDS / LOCAL_MODEL_IDS_REPLACE — bare ids that need the CLI's
# `local:` prefix. The shipped set was taken from one machine's `ainxt models`
# output; without this an adopter's local models were dispatched unprefixed.
#   LOCAL_MODEL_IDS=my-llm-7b,acme/coder-32b
#   LOCAL_MODEL_IDS_REPLACE=true      # use ONLY the configured set
#
# LOCAL_TIER_MODELS_{FAST,BALANCED,DEEP} — locally-served models preferred per
# routing tier. The cloud entries in that table now come from the registry.
#   LOCAL_TIER_MODELS_FAST=my-small-7b
#
# AINXT_DEFAULT_MODEL — model the desktop app passes to `ainxt --model` when
# neither caller nor session specifies one. Was hardcoded in four places.
AINXT_DEFAULT_MODEL=
#
# GUARDRAILS_MODEL — model NeMo Guardrails uses for its own rails checks
# (guardrails/config.yml). Was the literal 'Kimi-k2.5', one specific
# locally-served model, while the same file already env-substituted its
# base_url and api_key. Guardrails calling a nonexistent model fails open.
GUARDRAILS_MODEL=Kimi-k2.5
#
# Frontend defaults are BUILD-time (Vite), not runtime — see
# ai-ui/src/config.js and ABStudio/frontend/src/config/models.js:
#   VITE_MODEL_DEFAULT, VITE_MODEL_PICKER, VITE_MODEL_IMAGE,
#   VITE_ABS_RECOMMENDED_MODEL, VITE_ABS_DEFAULT_NODE_MODEL

# DOC_BRAND_NAME / DOC_BRAND_MARK — the brand stamped INTO generated files
# (docx/pdf footer, pptx classification line + file author, xlsx summary label)
# and the optional logo image.
#
# ⚠ These are IMAGE-BUILD arguments, NOT runtime settings. Setting them in this
# file has NO effect: the doc sandbox container is started with no environment
# passed in from the host (see sandbox/docker_executor.py), so the composition
# libraries can only see values baked into the image. Listing them here as
# runtime variables would be a control that looks configured but does nothing.
#
#   docker build --build-arg DOC_BRAND_NAME="Your Org" \
#                --build-arg DOC_BRAND_MARK=/opt/ainxt-brand/brand-mark.png \
#                -f docker/doc-sandbox/Dockerfile .
#
# Defaults: DOC_BRAND_NAME is EMPTY, so generated documents show the
# classification alone with no organisation name. DOC_BRAND_MARK points at
# /opt/ainxt-brand/brand-mark.png; every use is guarded by an existence check,
# so no logo file simply means no logo. Put your own PNG in
# skills/ainxt_doc_craft/brand/ (it is COPYied into the image) to use one.

# ENABLE_DOC_VISION_QA — enable vision-model QA pass on generated documents.
# When true, each generated document page is reviewed by a vision model against
# the brand contract (DOC_BRAND_FILE) before delivery. Fails open — a missing
# vision model or proxy error never blocks document delivery.
# true (default) — enabled. Adds one vision LLM call per page reviewed.
# false          — disabled. Saves vision API cost; no brand QA performed.
ENABLE_DOC_VISION_QA=true

# DOC_VISION_QA_MAX_PAGES — maximum number of pages reviewed per document.
# Default: 4. Increase for thorough QA; decrease to reduce vision API cost.
DOC_VISION_QA_MAX_PAGES=4


