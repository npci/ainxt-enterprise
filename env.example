ENABLE_EXTERNAL_SYNC=false


# =============================================================================
# SKILLS / EXTERNAL FEATURES
# =============================================================================
# ENABLE_SKILL_LOOP — background loop that continuously evaluates and improves
# agent skills. Requires additional worker infrastructure.
# OSS default: false
ENABLE_SKILL_LOOP=false
# Skill loop tuning — only relevant when ENABLE_SKILL_LOOP=true
SKILL_LOOP_INTERVAL_SEC=1800
SKILL_LOOP_WINDOW_SEC=604800
SKILL_LOOP_THRESHOLD=5
SKILL_LOOP_MAX_PROPOSALS_PER_RUN=3
SKILL_LOOP_SOURCES=cowork_task


# =============================================================================
# ORGANISATION-SPECIFIC INTEGRATION FEATURE FLAGS
# =============================================================================
# All default to false for OSS. When false, the router is not mounted at all —
# no endpoints, no initialization, no credential warnings.
# Some deployments set these to true in their .env.

# Zoho HR — syncs employee data from Zoho People API.
# Requires: ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET, ZOHO_REFRESH_TOKEN
ENABLE_ZOHO_HR=false

# HOD digest — monthly per-department LLM spend digest emails to Heads of Dept.
# Requires: AINXT_SMTP_HOST, department_hod_mapping table populated.
ENABLE_HOD_DIGEST=false

# LLM spend report — admin endpoints for LLM cost tracking and reporting.
# Requires: OpenAI/Anthropic admin API keys (OPENAI_ADMIN_API_KEY etc.)
ENABLE_LLM_SPEND_REPORT=false

# Monthly statement — sends monthly LLM usage statements to users via email.
# Requires: AINXT_SMTP_HOST
ENABLE_MONTHLY_STATEMENT=false

# Broadcast — admin email broadcast to all/filtered users.
# Requires: AINXT_SMTP_HOST, BROADCAST_ALLOWED_EMAILS
ENABLE_BROADCAST=false

# Graph webhooks — Azure AD Graph API subscription for user/group change events.
# Requires: Azure AD credentials and a Graph API subscription.
ENABLE_GRAPH_WEBHOOKS=false

# Webhooks — inbound webhooks from Jira and GitLab for SDLC automation.
# Requires: JIRA_WEBHOOK_SECRET, GITLAB_WEBHOOK_SECRET
ENABLE_WEBHOOKS=false

# Jira integration
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=
JIRA_WEBHOOK_SECRET=

# GitLab integration
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# Slack — bidirectional Slack bot integration and HITL notifications.
# Requires: SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET
ENABLE_SLACK=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#general

# Teams — Microsoft Teams bot integration and SDLC HITL via Adaptive Cards.
# Requires: TEAMS_BOT_SECRET, Teams app registration.
ENABLE_TEAMS=false


