# =============================================================================
# CLI / MESSAGES COMPAT (auto-compaction + context management)
# =============================================================================
# These control how the platform manages long chat histories for the CLI and
# the OpenAI-compatible /messages endpoint. All have safe defaults — only
# tune these if you are hitting context-window limits or want to adjust
# compaction behaviour.

# COMPACTION_THRESHOLD_FRACTION — when the assembled conversation exceeds this
# fraction of the model's context window, auto-compaction is triggered.
# The head (older messages) is summarised; the tail is kept verbatim.
# Default: 0.70 (compact when 70% of context window is used)
COMPACTION_THRESHOLD_FRACTION=0.70

# COMPACTION_KEEP_TURNS — number of most-recent message turns to preserve
# verbatim during compaction (the "tail"). Older turns are summarised.
# Default: 10
COMPACTION_KEEP_TURNS=10

# COMPACTION_MODEL_HINT — which model to use for compaction summarisation.
# "simple" = use the cheapest/fastest available model (recommended for OSS).
# Set to a specific model name (e.g. "ollama/llama3.2") to pin the model.
# Default: simple
COMPACTION_MODEL_HINT=simple

# LOCAL_CONTEXT_SAFETY_FRACTION — safety margin applied to local LLM context
# window size. Prevents hitting the hard limit by leaving a buffer.
# Default: 0.90 (use at most 90% of the reported context window)
LOCAL_CONTEXT_SAFETY_FRACTION=0.90

# LOCAL_LLM_TOOLS — whether local LLMs (Ollama, local endpoints) can use
# tool/function calling. Set to false if your local model does not support
# tool calling (e.g. some quantised models) to avoid errors.
# Default: true
LOCAL_LLM_TOOLS=true

# TRACK_CACHE_TOKENS — whether to track  prompt cache token usage
# (cache_creation_input_tokens, cache_read_input_tokens) in usage records.
# Only relevant when using  models with prompt caching.
# Default: false
TRACK_CACHE_TOKENS=false

# AINXT_PLATFORM_SERVICE_API_KEYS — comma-separated API keys for
# service-to-service calls (e.g. another internal service calling the
# /messages endpoint directly). Leave empty unless you are integrating
# the platform as a backend service from another application.
# Example: AINXT_PLATFORM_SERVICE_API_KEYS=svc-key-1,svc-key-2
AINXT_PLATFORM_SERVICE_API_KEYS=

