# =============================================================================
# SSL/TLS CONFIGURATION (for OSS compliance)
# =============================================================================
# Default: true. TLS certificate verification is enabled by default for
# outbound HTTPS calls (e.g., Atlassian, NeMo, OpenAI-compatible endpoints).
# - Use 'true' in production and in CI.
# - Set to 'false' only for local/dev environments with self-signed certificates.
# - Prefer SSL_CA_BUNDLE (below) over disabling verification.
SSL_VERIFY=true

# Optional: path to CA bundle for custom/internal certificates.
# If set, this file will be used for TLS verification instead of the system CA.
# SSL_CA_BUNDLE=/path/to/ca-bundle.crt


# =============================================================================
# FIREWALL / NETWORK (reference only)
# =============================================================================
