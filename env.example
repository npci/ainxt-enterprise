# =============================================================================
# PLATFORM
# =============================================================================
# Base URL of your platform (nginx / load balancer). Used for email links,
# OAuth redirects, and internal service-to-service calls.
PLATFORM_BASE_URL=http://localhost:9001

# Kafka — async event streaming (optional)
# KAFKA_ENABLED=false (OSS default) — direct ingest, no Kafka required.
# KAFKA_ENABLED=true  — enable Kafka for high-throughput event streaming.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_TOPIC_PREFIX — prefix for all Kafka topic names. Defaults to APP_OWNER.
# Example: if APP_OWNER=ainxt, topics are ainxt.chat_history, ainxt.coach_events etc.
# Only set this if you need a different prefix from APP_OWNER.
KAFKA_TOPIC_PREFIX=


# =============================================================================
# PLATFORM TIMEZONE
# =============================================================================
# Controls the local time used for all cron job schedules (thread purge,
# AD sync, governance SLA check, partition maintenance, etc.).
# Any IANA timezone string is valid.
#
# UTC           (OSS default) — simple and predictable for any location.
# Asia/Kolkata  (example) — IST schedule preserved.
# America/New_York, Europe/London, etc. — set to your deployment timezone.
PLATFORM_TIMEZONE=UTC


# =============================================================================
# TELEMETRY / OBSERVABILITY
# =============================================================================
# Disable telemetry by default for OSS contributors (set to false to enable)
DISABLE_TELEMETRY=true

# OpenTelemetry tracing — set ENABLE_TRACING=1 to enable
ENABLE_TRACING=
OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=

# METRIC_PREFIX — prefix for all Prometheus metric names.
# OSS default: "ainxt"  → metrics: ainxt_requests_total, ainxt_model_calls_total etc.
# Legacy:      "<legacy-prefix>" → keeps an existing deployment's Grafana dashboards working.
# Must be set before gateway starts — metric names are registered at import time.
METRIC_PREFIX=ainxt


# =============================================================================
# EVALUATION ENGINE
# =============================================================================
# EVAL_ENABLED — LLM-as-judge quality evaluation after every chat response.
# When true, each chat message triggers an additional LLM call to score the
# response quality. This doubles API cost and adds 1-3s latency per message.
#
# false (OSS default) — disabled. No extra cost or latency. Recommended for
#                       local dev, Ollama users, and small teams.
# true  (enterprise)        — enabled. Used for org-wide quality monitoring.
EVAL_ENABLED=false
EVAL_ENGINE=
TENX_EVAL_ENGINE=
TENX_EVAL_PASSES=3


# =============================================================================
# ENHANCEMENT / REASONING
# =============================================================================
ADVANCED_REASONING_ENABLED=false
ENHANCE_MODEL_HINT=
ENRICH_MODEL=


# =============================================================================
# RUNTIME CLIENT (ainxt-runtimed sidecar — optional)
# =============================================================================
# ainxt-runtimed is an optional high-performance sidecar service that can
# shadow or canary a percentage of chat traffic for A/B testing or performance
# benchmarking. Disabled by default — safe to ignore for standard deployments.
#
# ENABLE_RUNTIME — master flag. false (OSS default) = sidecar completely inactive.
# true = activate shadow/canary mode (requires ainxt-runtimed running).
ENABLE_RUNTIME=false

# RUNTIME_URL — URL of the ainxt-runtimed sidecar (loopback only — never expose
# to the browser). Only used when ENABLE_RUNTIME=true.
RUNTIME_URL=http://127.0.0.1:8080

# RUNTIME_TIMEOUT — HTTP timeout in seconds for sidecar calls. Default: 60.
RUNTIME_TIMEOUT=60

# RUNTIME_PCT — canary percentage (0–100). 0 = shadow only (fire-and-forget,
# Python result always returned). 1–100 = that % of traffic routed to sidecar.
# Only used when ENABLE_RUNTIME=true.
RUNTIME_PCT=0


