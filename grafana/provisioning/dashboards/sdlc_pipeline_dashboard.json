      "collapsed": false
    },

    {
      "id": 33,
      "type": "table",
      "title": "All Runs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 73 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "started", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "width": 140, "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "state" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "FAILED":                    { "color": "red",    "index": 0 },
                  "CANCELLED":                 { "color": "grey",   "index": 1 },
                  "COMPLETE":                  { "color": "green",  "index": 2 },
                  "MERGED":                    { "color": "green",  "index": 3 },
                  "MERGE_READY":               { "color": "teal",   "index": 4 },
                  "AWAITING_PR_APPROVAL":      { "color": "orange", "index": 5 },
                  "AWAITING_DESIGN_APPROVAL":  { "color": "orange", "index": 6 },
                  "AWAITING_SOLUTION_APPROVAL":{ "color": "orange", "index": 7 },
                  "AWAITING_RE_REVIEW":        { "color": "orange", "index": 8 },
                  "MERGE_CONFLICT":            { "color": "red",    "index": 9 }
                }}
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "duration_s" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "jira_key" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "run_id" },
            "properties": [{ "id": "custom.width", "value": 300 }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT id as run_id, type as run_type, jira_key, state, current_stage, ROUND(EXTRACT(EPOCH FROM (COALESCE(updated_at, NOW()) - created_at))) as duration_s, TO_CHAR(created_at, 'YYYY-MM-DD HH24:MI') as started FROM sdlc_runs WHERE created_at BETWEEN $__timeFrom() AND $__timeTo() ORDER BY created_at DESC LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ]
    }

  ]
