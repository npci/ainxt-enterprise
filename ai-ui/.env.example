# ═══════════════════════════════════════════════════════════════════════════════
# AiNxt UI — Vite Build-Time Environment Variables
#
# Copy this file to ai-ui/.env before running `npm run dev` or `npm run build`:
#   cp ai-ui/.env.example ai-ui/.env
#
# All variables must be prefixed with VITE_ to be accessible in the browser.
# Values are baked in at build time — restart the dev server after changes.
# ═══════════════════════════════════════════════════════════════════════════════

# API base URL — must match where gateway.py is running.
VITE_API_URL=http://localhost:8000

# Default model shown in the chat UI when no model is selected.
# Must be a model ID that the backend accepts as a model_hint value.
# Leave blank to defer to the live /all-models catalogue from the backend.
VITE_MODEL_DEFAULT=

# Model shown for locked/privileged sessions (e.g. admin tools, IDE agent).
# Leave blank to defer to the live catalogue.
VITE_MODEL_DEFAULT_LOCKED=

# Default image generation model shown in the UI.
# Leave blank to defer to the live catalogue.
VITE_MODEL_IMAGE=

# Opus model alias used by the UI for the "Opus" shorthand.
VITE_MODEL_OPUS=

# Haiku model alias used by the UI for the "Haiku" shorthand.
VITE_MODEL_HAIKU=

# Model picker options shown in the chat UI.
# Format: model_id:Display Name,model_id:Display Name,...
# The model IDs must match what the backend accepts as model_hint values.
# Leave blank to populate from the live /all-models catalogue.
# Example for local-only deployment:
#   VITE_MODEL_PICKER=llama3.1:Llama 3.1,mistral:Mistral 7B
VITE_MODEL_PICKER=

# Enable/disable the Presenton (presentation generation) feature.
VITE_ENABLE_PRESENTON=true

# PII payload encryption — browser-side counterpart to the backend's
# PII_ENCRYPTION_KEY (core/pii_crypto.py). Must be the EXACT SAME 32-byte
# URL-safe base64 key as the backend's PII_ENCRYPTION_KEY, or the browser
# will fail to decrypt "pii:v1:" fields and encrypted PII will render as
# ciphertext. Only used when the backend's PII_PAYLOAD_ENCRYPTION_ENABLED=true
# (the frontend reads that flag live from GET /auth/ui-config). Leave blank
# to disable. Generate your own — do NOT reuse this sample in any real
# deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Sample (must match the backend's PII_ENCRYPTION_KEY sample in env.example):
#   VITE_PII_ENCRYPTION_KEY=12345678-sdfsafasfasfasfasf*******
VITE_PII_ENCRYPTION_KEY=
