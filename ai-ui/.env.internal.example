# ═══════════════════════════════════════════════════════════════════════════════
# AiNxt UI — Internal Deployment Overlay
#
# HOW TO USE:
#   cp ai-ui/.env.example ai-ui/.env
#   # then fill in values from this file that apply to your deployment
#
# These are the values used by the NPCI internal deployment.
# OSS users: configure your own model IDs in ai-ui/.env instead.
#
# Values are baked in at Vite build time — restart the dev server after changes.
# ═══════════════════════════════════════════════════════════════════════════════

# API base URL — points to the gateway.
VITE_API_URL=http://localhost:8000

# Default model shown in the chat UI when no model is selected.
VITE_MODEL_DEFAULT=claude-sonnet-4-6

# Model shown for locked/privileged sessions (e.g. admin tools, IDE agent).
VITE_MODEL_DEFAULT_LOCKED=claude-opus-4-8

# Default image generation model.
VITE_MODEL_IMAGE=gemini-3.1-flash-image

# Opus model alias used by the UI for the "Opus" shorthand.
VITE_MODEL_OPUS=claude-opus-4-7

# Haiku model alias used by the UI for the "Haiku" shorthand.
VITE_MODEL_HAIKU=claude-haiku-4-5

# Model picker options shown in the chat UI.
# Format: model_id:Display Name,model_id:Display Name,...
VITE_MODEL_PICKER=claude-sonnet-5:Sonnet 5,claude-opus-4-8:Opus 4.8,claude-sonnet-4-6:Sonnet 4.6,claude-opus-4-7:Opus 4.7,claude-haiku-4-5:Haiku 4.5

# Enable Presenton (presentation generation) feature.
VITE_ENABLE_PRESENTON=true
