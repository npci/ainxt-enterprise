# SDLC CLI config template — DO NOT edit this file directly for day-to-day use.
#
# This is the source `sdlc-setup.sh` copies from every time SDLC is
# (re-)enabled, substituting whichever provider key(s) are currently in
# `.env`. The generated `bin/config.toml` is overwritten on every run, so
# hand edits to it do not survive — change the provider/key in `.env` instead
# and re-run `./sdlc-setup.sh`.
#
# If you want a provider this template does not cover (or a fully custom
# enterprise gateway), copy this file to `bin/config.toml` yourself and edit
# it by hand — sdlc-setup.sh only ever generates the file, it never touches
# one that a human already created. See docs/KB_SETUP.md's sibling,
# docs/SDLC_CLI_SETUP.md, and the CLI's own bundled
# ~/.ainxt/docs/user-guide/11-custom-models.md for the full schema
# (extra_headers, capabilities, [endpoints], etc.).
#
# Exactly one of the [model.*] blocks below is active in a generated file —
# sdlc-setup.sh picks the block matching whichever provider is configured in
# .env (ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY / ollama) and
# deletes the rest. All placeholders below use the __UPPER_SNAKE__ form so
# the substitution step can find them unambiguously.

[models]
default = "sdlc-model"

# ── Anthropic (Claude) — used when ANTHROPIC_API_KEY is set in .env ────────
# Anthropic authenticates via the x-api-key header, not Authorization:
# Bearer, so the key rides in extra_headers rather than api_key/env_key.
[model.sdlc-model]
model = "__ANTHROPIC_MODEL_ID__"
base_url = "https://api.anthropic.com/v1"
name = "Claude (SDLC)"
api_backend = "messages"
context_window = 200000

[model.sdlc-model.extra_headers]
x-api-key = "__ANTHROPIC_API_KEY__"
anthropic-version = "2023-06-01"

# ── OpenAI — used when OPENAI_API_KEY is set in .env ────────────────────────
# api_backend defaults to chat_completions, so it is omitted here on purpose.
# [model.sdlc-model]
# model = "__OPENAI_MODEL_ID__"
# base_url = "https://api.openai.com/v1"
# name = "GPT (SDLC)"
# api_key = "__OPENAI_API_KEY__"
# context_window = 128000

# ── Google Gemini — used when GEMINI_API_KEY is set in .env ────────────────
# UNVERIFIED: the CLI's own docs do not document a confirmed Gemini recipe.
# This assumes Gemini's OpenAI-compatible endpoint; test before relying on it,
# and check ~/.ainxt/docs/user-guide/11-custom-models.md for anything newer.
# [model.sdlc-model]
# model = "__GEMINI_MODEL_ID__"
# base_url = "https://generativelanguage.googleapis.com/v1beta/openai"
# name = "Gemini (SDLC)"
# api_key = "__GEMINI_API_KEY__"
# context_window = 1000000

# ── Ollama (local) — used when PROVIDER=ollama and no cloud key is set ─────
# "ollama" here is the Docker Compose service name (ainxt_net network), not
# localhost — this file only ever runs inside the sdlc-worker container.
# Ollama does not check the credential, but the CLI refuses to start with
# none set at all, so a non-empty placeholder is required (see the CLI's own
# Ollama note in 11-custom-models.md).
# [model.sdlc-model]
# model = "__OLLAMA_MODEL_ID__"
# base_url = "http://ollama:11434/v1"
# name = "Ollama (SDLC)"
# api_key = "local-placeholder"
# context_window = 8192
