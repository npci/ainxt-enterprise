# =============================================================================
# AiNxt Platform — INTERNAL DEPLOYMENT PROFILE
#
# This file is the internal counterpart to .env.example.
# .env.example has all values blank — no vendor, no model, no endpoint.
# This file has the real values for an internal/self-hosted deployment.
#
# HOW TO USE:
#   cp .env.example .env
#   # then fill in the values from this file that apply to your deployment
#
# DO NOT COMMIT a filled-in .env — it is gitignored for a reason.
# This file itself is safe to commit: it is a template, not a live config.
# =============================================================================


# ── ANTHROPIC / CLAUDE MODEL IDs ─────────────────────────────────────────────
# Set these when ANTHROPIC_API_KEY is configured.
CLAUDE_PRIMARY_MODEL=claude-sonnet-4-6
# Main reasoning model — "complex" routing tier and SDLC pipeline.

CLAUDE_HAIKU=claude-haiku-4-5
# Fast/lightweight — "haiku" tier, classification, expansion tasks.

CLAUDE_OPUS_MODEL=claude-opus-4-7
# Highest-capability — "solution" tier (SDLC code review, synthesis).

CLAUDE_OPUS_48_MODEL=claude-opus-4-8
# Opt-in — requires ENABLE_CLI_OPUS_48=true.

CLAUDE_OPUS_5_MODEL=claude-opus-5
# Opt-in — requires ENABLE_CLI_OPUS_5=true.

CLAUDE_SONNET_5_MODEL=claude-sonnet-5
# Latest Sonnet — requires ENABLE_SONNET_5=true.


# ── OPENAI / GPT MODEL IDs ───────────────────────────────────────────────────
# Set these when OPENAI_API_KEY is configured.
OPENAI_SIMPLE_MODEL=gpt-5-mini
# Fast/cheap — "mini" routing tier.

OPENAI_CODING_MODEL=gpt-5.4
# Coding and reasoning — "medium" routing tier.

OPENAI_LATEST_MODEL=gpt-5.5
# Latest GPT — "deep" routing tier.

OPENAI_TERA_MODEL=gpt-5.6-terra
# High-capacity — "tera" tier (requires ENABLE_GPT56_TERA=true).

OPENAI_LUNA_MODEL=gpt-5.6-luna
# Efficient variant — "luna" tier (requires ENABLE_GPT56_LUNA=true).

OPENAI_OSS_MODEL=glm-5.2-fp8
# In-house hosted model over OpenAI-compatible API — "local_mini" tier.
# Costed at $0.00. Change to whatever your runtime serves.

OPENAI_DEEP_RESEARCH_MINI=o4-mini-deep-research
OPENAI_DEEP_RESEARCH=o3-deep-research

OPENAI_IMAGE_MODEL=dall-e-3
# Image generation. Change to your Azure deployment name if using Azure.


# ── GOOGLE / GEMINI MODEL IDs ────────────────────────────────────────────────
# Set these when GEMINI_API_KEY is configured.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_CODING_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VISION_MODEL=gemini-3.5-flash
VEO_MODEL=veo-3.1-generate-preview
VEO_ENABLED=true
VEO_DISPLAY=Veo 3.1 (video preview)
VEO_COST_PER_SECOND=0.40

# Vision routing
PRIMARY_VISION_PROVIDER=gemini
FALLBACK_VISION_PROVIDER=openai
# LOCAL_VISION_MODELS=llava:13b,bakllava:7b   # uncomment for local vision


# ── EMBEDDING MODELS ─────────────────────────────────────────────────────────
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OPENAI_EMBED_MODEL=text-embedding-3-small
NOMIC_EMBED_MODEL=nomic-embed-text-v1.5


# ── SELF-HOSTED / LOCAL LLM ──────────────────────────────────────────────────
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=sk-local
LOCAL_LLM_MODEL_NAME=local-llm
LOCAL_LLM_TOOLS=true


# ── INTERNAL GATEWAY ─────────────────────────────────────────────────────────
# Internal LLM proxy / gateway used by CodeWiki and some workers.
NEURON_BASE_URL=
NEURON_API_KEY=

LLM_PROXY_URL=
LLM_PROXY_TOKEN=


# ── CHAT FALLBACK CHAIN ──────────────────────────────────────────────────────
# Ordered fallback when the primary model is unavailable.
# Internal deployment: try in-house models first, cloud as last resort.
CHAT_FALLBACK_CHAIN=local:kimi-k2.7-code,local:glm-5.2,haiku


# ── EMBEDDING ENRICHMENT ─────────────────────────────────────────────────────
ENRICH_MODEL=haiku
# Tier hint for embedding enrichment. Internal: use haiku tier.


# ── ABSTUDIO (BUILD STUDIO) MODEL SETTINGS ───────────────────────────────────
ABSTUDIO_AGENT_DEFAULT_MODEL=
# Leave blank — the workflow factory picks from the live catalogue by tier.
# Set to a specific model id to override for all generated agents.

FACTORY_MODEL=
# Meta-model for the workflow factory itself. Leave blank to use LOCAL_LLM_MODEL.

# Frontend build-time overrides — set before `npm run build` if you want to
# pin a specific model in the UI rather than deferring to the live catalogue.
# VITE_ABS_RECOMMENDED_MODEL=claude-sonnet-4-6
# VITE_ABS_DEFAULT_NODE_MODEL=claude-haiku-4-5
# VITE_ABS_DEFAULT_NODE_PROVIDER=anthropic
# VITE_ABS_JUDGE_MODEL=claude-sonnet-4-6

AINXT_CLI_BIN=ainxt
# CLI binary used by skill-creator eval scripts.

# ── FEATURE FLAGS ────────────────────────────────────────────────────────────
LLM_PROVIDER=cloud
ENABLE_OPUS=true
ENABLE_CHAT_OPUS=false
ENABLE_RAW_OPENAI_API=false
SDLC_GROUNDING_CHARTER=true
BLOCKED_MODELS_EXTRA=


# ── AI-UI FRONTEND BUILD-TIME MODEL SETTINGS ─────────────────────────────────
# Set before `npm run build` in ai-ui/. Baked into the SPA at build time.
VITE_MODEL_DEFAULT=claude-sonnet-4-6
VITE_MODEL_DEFAULT_LOCKED=claude-opus-4-8
VITE_MODEL_IMAGE=gemini-3.1-flash-image
VITE_MODEL_OPUS=claude-opus-4-7
VITE_MODEL_HAIKU=claude-haiku-4-5
VITE_MODEL_PICKER=claude-sonnet-5:Sonnet 5,claude-opus-4-8:Opus 4.8,claude-sonnet-4-6:Sonnet 4.6,claude-opus-4-7:Opus 4.7,claude-haiku-4-5:Haiku 4.5


# ── INTERNAL PACKAGE MIRRORS (air-gapped builds) ─────────────────────────────
SANDBOX_DOCKER_REGISTRY=
SANDBOX_MAVEN_REPO_URL=
SANDBOX_NPM_REGISTRY_URL=
SANDBOX_PIP_INDEX_URL=
SANDBOX_GO_PROXY=
SANDBOX_GEM_SOURCE_URL=
SANDBOX_NUGET_SOURCE_URL=
SANDBOX_CARGO_REGISTRY_URL=
SANDBOX_COMPOSER_REPO_URL=
SANDBOX_MAVEN_REPO_USER=
SANDBOX_MAVEN_REPO_PWD=


# ── SECURITY & SESSION ───────────────────────────────────────────────────────
JWT_SECRET=                        # REQUIRED — generate: openssl rand -hex 32
AUDIT_SIGNING_KEY=                 # REQUIRED — generate: openssl rand -hex 32
FERNET_KEY=                        # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

JWT_EXPIRE_HOURS=24                # token lifetime in hours (default 24)
MAX_CONCURRENT_SESSIONS=10         # internal: higher limit for multi-device users
SESSION_ENFORCE_STRICT=false       # set true for high-security environments
APPROVAL_AD_LEVEL=6                # AD level threshold for SDLC approvals

# ── ENTERPRISE TLS ───────────────────────────────────────────────────────────
SSL_CA_BUNDLE=
SSL_VERIFY=true


# ── HSM / CKMS (optional) ────────────────────────────────────────────────────
CKMS_ENABLED=false
HSM_CONFIG_PATH=
